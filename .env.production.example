# Copy this file to /var/www/ember/.env.production on sydney2.
POSTGRES_DB=ember
POSTGRES_USER=ember
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://ember:replace-with-a-long-random-password@postgres:5432/ember?schema=public
SESSION_SECRET=replace-with-a-long-random-session-secret
# Use a separate long random value, for example: openssl rand -hex 32
MESSAGE_ENCRYPTION_KEY=replace-with-a-long-random-message-encryption-key
RESEND_API_KEY=replace-with-a-resend-api-key
MAIL_FROM=noreply@mail.shukelabs.com
APP_URL=https://bbs.shukelabs.com
POST_COOLDOWN_SECONDS=0
NODE_ENV=production
PORT=3001
