# Copy to .env after starting the local PostgreSQL service.
DATABASE_URL="postgresql://ember:ember@localhost:5432/ember?schema=public"
PORT=3001
# Signing key for session cookies. Use a long random string in production.
SESSION_SECRET="dev-secret-change-me"
# Secret used to derive the AES-256-GCM message encryption key. Replace this
# placeholder before using messages outside local development.
MESSAGE_ENCRYPTION_KEY="dev-secret-change-me"
